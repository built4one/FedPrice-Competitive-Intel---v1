# Required for solicitation analysis. Set server-side; never commit a real key.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4"
ENABLE_OPENAI_WEB_SEARCH="true"
SAM_API_KEY=""
BLS_API_KEY=""

# Private access and durable runs. Configure before sharing a preview.
# Generate password hashes with the local helper; keep real values in server secrets.
STUDIO_USERS_JSON="[]"
SESSION_SECRET=""
DATABASE_URL=""
# Local development only: STUDIO_LOCAL_MODE=1 enables localhost without a login.
# Hosted deployments require DATABASE_URL; local runs use a SQLite file.
