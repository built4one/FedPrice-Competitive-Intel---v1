# Required. Add this in Google AI Studio Secrets; never commit a real key.
GEMINI_API_KEY=""

# Optional model override.
GEMINI_MODEL="gemini-2.5-pro"

# Set false to skip grounded Google Search enrichment.
ENABLE_GOOGLE_SEARCH="true"

# Optional supplemental SAM.gov enrichment. The upload workflow does not depend on it.
SAM_API_KEY=""

# Optional higher BLS request quota. BLS works without a key at normal usage levels.
BLS_API_KEY=""
