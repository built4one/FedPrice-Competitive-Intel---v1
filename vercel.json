{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": ["fed-price-comp-intel-v1.vercel.app"],
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
